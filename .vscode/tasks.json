{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. 가상환경 생성",
            "type": "shell",
            "command": "python3",
            "args": [
                "-m",
                "venv",
                ".venv"
            ],
            "windows": {
                "command": "python",
                "args": [
                    "-m",
                    "venv",
                    ".venv"
                ]
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "2. 필요 라이브러리 설치",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements.txt"
            ],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "dependsOn": [
                "1. 가상환경 생성"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "3. 비율검정 검증 재현",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "src/origin/proportion_test.py"
            ],
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            },
            "dependsOn": [
                "2. 필요 라이브러리 설치"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            // R이 설치돼 있어야 함(Rscript가 PATH에 있어야 실행됨). 설치는 OS별로 별도 진행.
            "label": "4. R 비율검정 검증 시각화",
            "type": "shell",
            "command": "Rscript",
            "args": [
                "${workspaceFolder}/visualizations/proportion_test_R/proportion_test_viz.R"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
    ]
}
